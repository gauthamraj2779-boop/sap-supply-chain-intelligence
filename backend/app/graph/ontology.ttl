    rdfs:range xsd:string ;
    sap:sourceTable "AFKO" ;
    sap:sourceField "PLNBEZ" .

biz:order_qty a owl:DatatypeProperty ;
    rdfs:label "Total Order Quantity" ;
    rdfs:domain biz:ProductionOrder ;
    rdfs:range xsd:decimal ;
    sap:sourceTable "AFKO" ;
