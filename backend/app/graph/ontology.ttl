biz:required_qty a owl:DatatypeProperty ;
    rdfs:label "Requirement Quantity" ;
    rdfs:domain biz:Reservation ;
    rdfs:range xsd:decimal ;
    sap:sourceTable "RESB" ;
    sap:sourceField "BDMNG" .

biz:required_date a owl:DatatypeProperty ;
    rdfs:label "Requirement Date" ;
    rdfs:domain biz:Reservation ;
    rdfs:range xsd:date ;
    sap:sourceTable "RESB" ;
    sap:sourceField "BDTER" .

biz:vbeln a owl:DatatypeProperty ;
    rdfs:label "Sales Document" ;
    rdfs:domain biz:SalesOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "VBAK" ;
    sap:sourceField "VBELN" .

biz:kunnr a owl:DatatypeProperty ;
    rdfs:label "Sold-To Party" ;
    rdfs:domain biz:SalesOrder ;
