@prefix biz:  <http://sapkg.example/ontology#> .
@prefix sap:  <http://sapkg.example/sap#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://sapkg.example/ontology> a owl:Ontology ;
    rdfs:label "SAP Supply Chain Business Ontology" ;
    rdfs:comment "Business-semantic layer over SAP technical structures. Every term is annotated with the SAP table and field it derives from." ;
    owl:versionInfo "1.0.0" .

sap:sourceTable a owl:AnnotationProperty ; rdfs:label "SAP source table" .
sap:sourceField a owl:AnnotationProperty ; rdfs:label "SAP source field" .
sap:derivedFrom a owl:AnnotationProperty ; rdfs:label "SAP join expression" .
sap:inferred    a owl:AnnotationProperty ; rdfs:label "relationship inferred from data, not declared by a check table" .


# ======================================================================
# Classes
# ======================================================================

biz:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    skos:definition "An external party from which the enterprise procures materials." ;
    sap:sourceTable "LFA1" .

biz:Material a owl:Class ;
    rdfs:label "Material" ;
    skos:definition "A good that is procured, produced, stocked or sold." ;
    sap:sourceTable "MARA, MARC, MARD" .

biz:Plant a owl:Class ;
    rdfs:label "Plant" ;
    skos:definition "An operational unit that produces or stores materials." ;
    sap:sourceTable "T001W" .

biz:PurchaseOrder a owl:Class ;
    rdfs:label "PurchaseOrder" ;
    skos:definition "A commitment to buy a material from a supplier." ;
    sap:sourceTable "EKKO, EKPO" .

biz:ScheduleLine a owl:Class ;
    rdfs:label "ScheduleLine" ;
    skos:definition "A dated delivery commitment within a purchase order item." ;
    sap:sourceTable "EKET" .

biz:SourceList a owl:Class ;
    rdfs:label "SourceList" ;
    skos:definition "An approved supplier-material relationship with price and lead time." ;
    sap:sourceTable "EINA, EINE" .

biz:ProductionOrder a owl:Class ;
    rdfs:label "ProductionOrder" ;
    skos:definition "An order to manufacture a quantity of a material by a date." ;
    sap:sourceTable "AFKO, AFPO" .

biz:Reservation a owl:Class ;
    rdfs:label "Reservation" ;
    skos:definition "A dated component requirement raised by a production order." ;
    sap:sourceTable "RESB" .

biz:SalesOrder a owl:Class ;
    rdfs:label "SalesOrder" ;
    skos:definition "A customer commitment to buy finished goods." ;
    sap:sourceTable "VBAK, VBAP" .

biz:Delivery a owl:Class ;
    rdfs:label "Delivery" ;
    skos:definition "A planned outbound shipment fulfilling a sales order." ;
    sap:sourceTable "LIKP, LIPS" .

biz:Customer a owl:Class ;
    rdfs:label "Customer" ;
    skos:definition "A party to which finished goods are sold and shipped." ;
    sap:sourceTable "KNA1" .


# ======================================================================
# Datatype properties (SAP field -> business term)
# ======================================================================

biz:lifnr a owl:DatatypeProperty ;
    rdfs:label "Supplier Number" ;
    rdfs:domain biz:Supplier ;
    rdfs:range xsd:string ;
    sap:sourceTable "LFA1" ;
    sap:sourceField "LIFNR" .

biz:name a owl:DatatypeProperty ;
    rdfs:label "Supplier Name" ;
    rdfs:domain biz:Supplier ;
    rdfs:range xsd:string ;
    sap:sourceTable "LFA1" ;
    sap:sourceField "NAME1" .

biz:country a owl:DatatypeProperty ;
    rdfs:label "Country Key" ;
    rdfs:domain biz:Supplier ;
    rdfs:range xsd:string ;
    sap:sourceTable "LFA1" ;
    sap:sourceField "LAND1" .

biz:matnr a owl:DatatypeProperty ;
    rdfs:label "Material Number" ;
    rdfs:domain biz:Material ;
    rdfs:range xsd:string ;
    sap:sourceTable "MARA" ;
    sap:sourceField "MATNR" .

biz:name a owl:DatatypeProperty ;
