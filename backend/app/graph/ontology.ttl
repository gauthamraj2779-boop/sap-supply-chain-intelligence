biz:posnr a owl:DatatypeProperty ;
    rdfs:label "Sales Document Item" ;
    rdfs:domain biz:SalesOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "VBAP" ;
    sap:sourceField "POSNR" .

biz:matnr a owl:DatatypeProperty ;
    rdfs:label "Material Number" ;
    rdfs:domain biz:SalesOrder ;
