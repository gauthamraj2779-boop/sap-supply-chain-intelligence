biz:net_value a owl:DatatypeProperty ;
    rdfs:label "Net Order Value" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range xsd:decimal ;
    sap:sourceTable "EKPO" ;
    sap:sourceField "NETWR" .

biz:delivery_date a owl:DatatypeProperty ;
    rdfs:label "Item Delivery Date" ;
    rdfs:domain biz:ScheduleLine ;
    rdfs:range xsd:date ;
    sap:sourceTable "EKET" ;
    sap:sourceField "EINDT" .

biz:menge a owl:DatatypeProperty ;
    rdfs:label "Scheduled Quantity" ;
    rdfs:domain biz:ScheduleLine ;
