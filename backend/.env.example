# ---------------------------------------------------------------------------
# Everything here is OPTIONAL.
#
# With this file absent entirely, the backend still starts and serves complete
# impact analysis, financial quantification and avoidance planning from the
# in-process graph. Credentials add capability; they are never required.
# ---------------------------------------------------------------------------

# --- Graph backend ---------------------------------------------------------
# memory : in-process, zero setup, no credentials  (default)
# neo4j  : real Neo4j / Aura instance, enables raw Cypher
GRAPH_BACKEND=memory

# Fill these in, then set GRAPH_BACKEND=neo4j and run:
#   python -m app.graph.loader
# Get a free instance at https://console.neo4j.io (AuraDB Free).
# The password is shown ONCE at creation -- save it then.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- LLM provider ----------------------------------------------------------
# Adds prose narrative and LLM-assisted question parsing. Without it the
# system is fully functional: only the narrative is absent, and the
# deterministic parser still handles natural-language questions.
# One of: openai | deepseek | groq | azure | gemini | none
LLM_PROVIDER=openai

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Business assumptions (non-SAP inputs) ---------------------------------
# Per-plant values in the generated data override this default.
DEFAULT_IDLE_PLANT_COST_PER_DAY=180000
DEFAULT_LATE_DELIVERY_PENALTY_RATE=0.08
# Narrative figures diverging from computed values by more than this are flagged.
LLM_DIVERGENCE_TOLERANCE=0.05

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501
