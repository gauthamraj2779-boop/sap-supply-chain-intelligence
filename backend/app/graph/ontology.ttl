biz:country a owl:DatatypeProperty ;
    rdfs:label "Country Key" ;
    rdfs:domain biz:Customer ;
    rdfs:range xsd:string ;
    sap:sourceTable "KNA1" ;
    sap:sourceField "LAND1" .


# ======================================================================
# Object properties (relationships)
# ======================================================================

biz:supplies a owl:ObjectProperty ;
    rdfs:label "SUPPLIES" ;
    skos:definition "Supplier is an approved source for this material" ;
    rdfs:domain biz:Supplier ;
    rdfs:range biz:Material ;
    sap:derivedFrom "EINA.LIFNR -> LFA1.LIFNR" .

biz:fulfills a owl:ObjectProperty ;
    rdfs:label "FULFILLS" ;
    skos:definition "Supplier is the vendor on this purchase order" ;
    rdfs:domain biz:Supplier ;
    rdfs:range biz:PurchaseOrder ;
    sap:derivedFrom "EKKO.LIFNR -> LFA1.LIFNR" .

biz:orders a owl:ObjectProperty ;
    rdfs:label "ORDERS" ;
    skos:definition "Purchase order line procures this material" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range biz:Material ;
    sap:derivedFrom "EKPO.MATNR -> MARA.MATNR" .

biz:scheduledat a owl:ObjectProperty ;
    rdfs:label "SCHEDULED_AT" ;
    skos:definition "Delivery schedule for the purchase order item" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range biz:ScheduleLine ;
    sap:derivedFrom "EKET.EBELN+EBELP -> EKPO.EBELN+EBELP" .

biz:deliveredto a owl:ObjectProperty ;
    rdfs:label "DELIVERED_TO" ;
    skos:definition "Receiving plant for the purchase order item" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range biz:Plant ;
    sap:derivedFrom "EKPO.WERKS -> T001W.WERKS" .

biz:stockedat a owl:ObjectProperty ;
    rdfs:label "STOCKED_AT" ;
    skos:definition "Material carries stock at this plant" ;
    rdfs:domain biz:Material ;
    rdfs:range biz:Plant ;
    sap:derivedFrom "MARD.WERKS -> T001W.WERKS" .

biz:produces a owl:ObjectProperty ;
    rdfs:label "PRODUCES" ;
    skos:definition "Production order manufactures this material" ;
    rdfs:domain biz:ProductionOrder ;
    rdfs:range biz:Material ;
    sap:derivedFrom "AFPO.MATNR -> MARA.MATNR" .

biz:requires a owl:ObjectProperty ;
    rdfs:label "REQUIRES" ;
    skos:definition "Production order raises this component requirement" ;
    rdfs:domain biz:ProductionOrder ;
    rdfs:range biz:Reservation ;
    sap:derivedFrom "RESB.AUFNR -> AFKO.AUFNR" .

biz:consumes a owl:ObjectProperty ;
    rdfs:label "CONSUMES" ;
    skos:definition "Requirement consumes this material" ;
    rdfs:domain biz:Reservation ;
    rdfs:range biz:Material ;
    sap:derivedFrom "RESB.MATNR -> MARA.MATNR" .

biz:runsat a owl:ObjectProperty ;
    rdfs:label "RUNS_AT" ;
    skos:definition "Plant executing the production order" ;
    rdfs:domain biz:ProductionOrder ;
    rdfs:range biz:Plant ;
    sap:derivedFrom "AFKO.WERKS -> T001W.WERKS" .

biz:soldto a owl:ObjectProperty ;
    rdfs:label "SOLD_TO" ;
    skos:definition "Customer that placed the sales order" ;
    rdfs:domain biz:SalesOrder ;
    rdfs:range biz:Customer ;
    sap:derivedFrom "VBAK.KUNNR -> KNA1.KUNNR" .

biz:demands a owl:ObjectProperty ;
    rdfs:label "DEMANDS" ;
    skos:definition "Sales order line demands this finished material" ;
    rdfs:domain biz:SalesOrder ;
    rdfs:range biz:Material ;
    sap:derivedFrom "VBAP.MATNR -> MARA.MATNR" .

biz:fulfillsorder a owl:ObjectProperty ;
    rdfs:label "FULFILLS_ORDER" ;
    skos:definition "Delivery fulfils this sales order" ;
    rdfs:domain biz:Delivery ;
    rdfs:range biz:SalesOrder ;
    sap:inferred true ;
    sap:derivedFrom "LIPS.VGBEL -> VBAK.VBELN" .

biz:shipsfrom a owl:ObjectProperty ;
    rdfs:label "SHIPS_FROM" ;
    skos:definition "Shipping point plant for the delivery" ;
    rdfs:domain biz:Delivery ;
    rdfs:range biz:Plant ;
    sap:derivedFrom "LIKP.VSTEL -> T001W.WERKS" .

biz:shipsto a owl:ObjectProperty ;
    rdfs:label "SHIPS_TO" ;
    skos:definition "Customer receiving the delivery" ;
    rdfs:domain biz:Delivery ;
    rdfs:range biz:Customer ;
    sap:derivedFrom "LIKP.KUNNR -> KNA1.KUNNR" .


# ======================================================================
# SHACL shapes -- the governance gate.
# A record failing these is loaded but flagged, and lowers the
# data_completeness component of the published confidence score.
# ======================================================================

biz:SupplierShape a sh:NodeShape ;
    sh:targetClass biz:Supplier ;
    sh:property [
        sh:path biz:lifnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Supplier.lifnr is required (SAP source: LFA1.LIFNR)" ;
    ] ;
    sh:property [
        sh:path biz:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Supplier.name is required (SAP source: LFA1.NAME1)" ;
    ] ;
    sh:closed false .

biz:MaterialShape a sh:NodeShape ;
    sh:targetClass biz:Material ;
    sh:property [
        sh:path biz:matnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Material.matnr is required (SAP source: MARA.MATNR)" ;
    ] ;
    sh:property [
        sh:path biz:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Material.name is required (SAP source: MARA.MAKTX)" ;
    ] ;
    sh:closed false .

biz:PlantShape a sh:NodeShape ;
    sh:targetClass biz:Plant ;
    sh:property [
        sh:path biz:werks ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Plant.werks is required (SAP source: T001W.WERKS)" ;
    ] ;
    sh:property [
        sh:path biz:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Plant.name is required (SAP source: T001W.NAME1)" ;
    ] ;
    sh:closed false .

biz:PurchaseOrderShape a sh:NodeShape ;
    sh:targetClass biz:PurchaseOrder ;
    sh:property [
        sh:path biz:ebeln ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "PurchaseOrder.ebeln is required (SAP source: EKKO.EBELN)" ;
    ] ;
    sh:property [
        sh:path biz:matnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "PurchaseOrder.matnr is required (SAP source: EKPO.MATNR)" ;
    ] ;
    sh:property [
        sh:path biz:net_value ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "PurchaseOrder.net_value is required (SAP source: EKPO.NETWR)" ;
    ] ;
    sh:closed false .

biz:ScheduleLineShape a sh:NodeShape ;
    sh:targetClass biz:ScheduleLine ;
    sh:property [
        sh:path biz:delivery_date ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "ScheduleLine.delivery_date is required (SAP source: EKET.EINDT)" ;
    ] ;
    sh:property [
        sh:path biz:menge ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "ScheduleLine.menge is required (SAP source: EKET.MENGE)" ;
    ] ;
    sh:closed false .

biz:SourceListShape a sh:NodeShape ;
    sh:targetClass biz:SourceList ;
    sh:property [
        sh:path biz:matnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "SourceList.matnr is required (SAP source: EINA.MATNR)" ;
    ] ;
    sh:property [
        sh:path biz:lifnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "SourceList.lifnr is required (SAP source: EINA.LIFNR)" ;
    ] ;
    sh:closed false .

biz:ProductionOrderShape a sh:NodeShape ;
    sh:targetClass biz:ProductionOrder ;
    sh:property [
        sh:path biz:aufnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "ProductionOrder.aufnr is required (SAP source: AFKO.AUFNR)" ;
    ] ;
    sh:property [
        sh:path biz:output_matnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "ProductionOrder.output_matnr is required (SAP source: AFKO.PLNBEZ)" ;
    ] ;
    sh:property [
        sh:path biz:scheduled_finish ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "ProductionOrder.scheduled_finish is required (SAP source: AFKO.GLTRP)" ;
    ] ;
    sh:closed false .

biz:ReservationShape a sh:NodeShape ;
    sh:targetClass biz:Reservation ;
    sh:property [
        sh:path biz:aufnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Reservation.aufnr is required (SAP source: RESB.AUFNR)" ;
    ] ;
    sh:property [
        sh:path biz:matnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Reservation.matnr is required (SAP source: RESB.MATNR)" ;
    ] ;
    sh:property [
        sh:path biz:required_qty ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "Reservation.required_qty is required (SAP source: RESB.BDMNG)" ;
    ] ;
    sh:property [
        sh:path biz:required_date ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Reservation.required_date is required (SAP source: RESB.BDTER)" ;
    ] ;
    sh:closed false .

biz:SalesOrderShape a sh:NodeShape ;
    sh:targetClass biz:SalesOrder ;
    sh:property [
        sh:path biz:vbeln ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "SalesOrder.vbeln is required (SAP source: VBAK.VBELN)" ;
    ] ;
    sh:property [
        sh:path biz:matnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "SalesOrder.matnr is required (SAP source: VBAP.MATNR)" ;
    ] ;
    sh:property [
        sh:path biz:net_value ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "SalesOrder.net_value is required (SAP source: VBAP.NETWR)" ;
    ] ;
    sh:closed false .

biz:DeliveryShape a sh:NodeShape ;
    sh:targetClass biz:Delivery ;
    sh:property [
        sh:path biz:vbeln ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Delivery.vbeln is required (SAP source: LIKP.VBELN)" ;
    ] ;
    sh:property [
        sh:path biz:planned_goods_issue ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Delivery.planned_goods_issue is required (SAP source: LIKP.LFDAT)" ;
    ] ;
    sh:closed false .

biz:CustomerShape a sh:NodeShape ;
    sh:targetClass biz:Customer ;
    sh:property [
        sh:path biz:kunnr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Customer.kunnr is required (SAP source: KNA1.KUNNR)" ;
    ] ;
    sh:property [
        sh:path biz:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Customer.name is required (SAP source: KNA1.NAME1)" ;
    ] ;
    sh:closed false .

# Business rule: a schedule line cannot promise delivery before the
# purchase order that contains it was even created.
biz:ScheduleLineDateShape a sh:NodeShape ;
    sh:targetClass biz:ScheduleLine ;
    sh:property [
        sh:path biz:delivery_date ;
        sh:datatype xsd:date ;
        sh:message "ScheduleLine.delivery_date must be a valid date (EKET.EINDT)" ;
    ] .
