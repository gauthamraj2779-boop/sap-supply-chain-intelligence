    sap:sourceTable "EKET" ;
    sap:sourceField "MENGE" .

biz:matnr a owl:DatatypeProperty ;
    rdfs:label "Material Number" ;
    rdfs:domain biz:SourceList ;
    rdfs:range xsd:string ;
    sap:sourceTable "EINA" ;
    sap:sourceField "MATNR" .

biz:lifnr a owl:DatatypeProperty ;
    rdfs:label "Supplier Number" ;
    rdfs:domain biz:SourceList ;
    rdfs:range xsd:string ;
    sap:sourceTable "EINA" ;
    sap:sourceField "LIFNR" .

biz:net_price a owl:DatatypeProperty ;
    rdfs:label "Net Price" ;
    rdfs:domain biz:SourceList ;
    rdfs:range xsd:decimal ;
    sap:sourceTable "EINE" ;
    sap:sourceField "NETPR" .

biz:lead_time_days a owl:DatatypeProperty ;
    rdfs:label "Planned Delivery Time" ;
    rdfs:domain biz:SourceList ;
    rdfs:range xsd:string ;
    sap:sourceTable "EINE" ;
    sap:sourceField "APLFZ" .

biz:aufnr a owl:DatatypeProperty ;
    rdfs:label "Order Number" ;
    rdfs:domain biz:ProductionOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "AFKO" ;
