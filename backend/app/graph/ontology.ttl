biz:name a owl:DatatypeProperty ;
    rdfs:label "Plant Name" ;
    rdfs:domain biz:Plant ;
    rdfs:range xsd:string ;
    sap:sourceTable "T001W" ;
    sap:sourceField "NAME1" .

biz:country a owl:DatatypeProperty ;
    rdfs:label "Country Key" ;
    rdfs:domain biz:Plant ;
    rdfs:range xsd:string ;
    sap:sourceTable "T001W" ;
    sap:sourceField "LAND1" .

biz:ebeln a owl:DatatypeProperty ;
    rdfs:label "Purchasing Document Number" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "EKKO" ;
    sap:sourceField "EBELN" .

biz:lifnr a owl:DatatypeProperty ;
    rdfs:label "Supplier Number" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "EKKO" ;
    sap:sourceField "LIFNR" .

biz:ebelp a owl:DatatypeProperty ;
    rdfs:label "Item Number" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "EKPO" ;
    sap:sourceField "EBELP" .

biz:matnr a owl:DatatypeProperty ;
    rdfs:label "Material Number" ;
    rdfs:domain biz:PurchaseOrder ;
    rdfs:range xsd:string ;
    sap:sourceTable "EKPO" ;
